# 服务端口
PORT=8787

# 后台查询口令：配置后，统计页面与 /api/admin/* 接口都需要输入该口令
ADMIN_TOKEN=请改成你自己的口令

# 允许上报的来源白名单（逗号分隔）。建议填多维表格插件的来源域名；
# 留空表示不限制来源（内网自用可以留空）
ALLOWED_ORIGINS=

# 插件前端构建产物目录（可选）。默认取仓库根目录的 dist，
# 由本服务在 /plugin/ 下托管，与统计接口同源。
# PLUGIN_DIST_DIR=../dist

# 数据库存放位置（可选，默认 server/data/usage.db）
# DATA_DIR=./data
# DB_FILE=./data/usage.db